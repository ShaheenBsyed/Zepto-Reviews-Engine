# ============================================================
# Zepto AI Review Engine — Environment Variables
# ============================================================
# COST: This entire pipeline runs FREE OF CHARGE.
#   - Gemini 1.5 Flash : free via Google AI Studio (15 RPM, 1M tokens/day)
#   - Embeddings       : sentence-transformers runs locally (no API, no cost)
#   - Vector DB        : ChromaDB runs locally (no cloud, no cost)
#   - Play Store       : google-play-scraper — no API key required
#   - App Store        : app-store-scraper — no API key required
#   - Community forums : public scraping via BeautifulSoup — no API key required
#
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
# That is the ONLY credential this project needs.
# ============================================================

# ── Google Gemini (FREE — only required credential) ──────────
# Required for: theme labeling (Phase 4), insight generation (Phase 5),
#               and RAGAS faithfulness evaluation (Phase 6)
# Free tier limits: 15 requests/min, 1 million tokens/day
GEMINI_API_KEY=

# ── Twitter / X (DISABLED — not free) ────────────────────────
TWITTER_ENABLED=false

# ── Pipeline Configuration ───────────────────────────────────

# LLM model. gemini-2.5-flash is the current free-tier model.
LLM_MODEL=gemini-2.5-flash

# Embedding model. Runs fully locally via sentence-transformers — no API cost.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB backend. chromadb runs locally — no cloud account needed.
VECTOR_DB_BACKEND=chromadb

# Path to the ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIR=./data/embeddings/chroma

# Path to the SQLite raw data store (relative to project root)
SQLITE_DB_PATH=./data/raw/reviews.db

# Data collection window
INGESTION_START_DATE=2024-01-01
INGESTION_END_DATE=current
SCRAPE_LOOKBACK_MONTHS=24

# Max documents per source (−1 = unlimited)
MAX_DOCUMENTS_PLAY_STORE=10000
MAX_DOCUMENTS_APP_STORE=10000
MAX_DOCUMENTS_QUORA=5000
MAX_DOCUMENTS_BLOG=5000
MAX_DOCUMENTS_PRODUCT_REVIEW=5000
MAX_DOCUMENTS_FORUM=5000
MAX_DOCUMENTS_TWITTER=1000
MAX_DOCUMENTS_CSV=-1

# CSV upload directory (relative to project root)
CSV_UPLOAD_DIR=./data/csv_uploads

# Whether to include Hinglish reviews (true | false).
INCLUDE_HINGLISH=false

# Minimum word count for a review to pass noise filtering
MIN_REVIEW_WORD_COUNT=15

# RAG retrieval: number of top-K chunks to retrieve per research question
RAG_TOP_K=10

# RAGAS faithfulness threshold
FAITHFULNESS_THRESHOLD=0.7
