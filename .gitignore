# ── Node.js ─────────────────────────────────────────────────
node_modules/
.next/
out/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
pip-log.txt

# ── Data (raw and processed — not committed to git) ─────────
data/raw/*.db
data/raw/*.jsonl
data/raw/*.json
data/processed/
data/embeddings/

# ── Outputs (generated artifacts) ────────────────────────────
